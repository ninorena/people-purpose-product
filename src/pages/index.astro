---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PostRows from '../components/PostRows.astro';
import portrait from '../assets/nick-portrait.jpg';
import { SCHEDULING_LINK, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<MarketingLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="wrap hero">
		<div class="hero-text">
			<p class="label">Product ownership for mission-driven teams</p>
			<h1>You're closest to the problem. Product ownership belongs with you.</h1>
			<p class="lede">
				The job is deciding what to build, in what order, and how you'll know it helped the
				people you serve. Most teams like yours never had a product owner. I work as yours,
				and I leave your team able to do the job without me.
			</p>
			<div class="cta-row">
				<a class="primary" href={SCHEDULING_LINK} target="_blank" rel="noopener noreferrer">Book 30 minutes &rarr;</a>
				<a class="secondary" href="/work">Three ways we could work together</a>
			</div>
		</div>
		<Image class="portrait" src={portrait} width={600} height={750} alt="Nick Noreña" loading="eager" />
	</section>

	<section class="wrap ways">
		<div class="label ruled">Three ways to work together</div>
		<div class="ways-grid">
			<div class="way">
				<h3>Product studio</h3>
				<p>I own the roadmap and bring the engineers. You get a working product, and a team that can tell you why it was built this way.</p>
			</div>
			<div class="way">
				<h3>Fractional product owner</h3>
				<p>The roadmap stays yours. I take the product owner seat on your team and sit in the meetings.</p>
			</div>
			<div class="way">
				<h3>Product owner coaching</h3>
				<p>For the person already doing this job without the title. Then you keep doing it after I'm gone.</p>
			</div>
		</div>
	</section>

	<section class="wrap writing">
		<PostRows label="Writing" posts={recentPosts} />
	</section>
</MarketingLayout>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 300px;
		gap: 64px;
		align-items: start;
		padding-top: 88px;
		padding-bottom: 88px;
	}
	.hero-text {
		display: flex;
		flex-direction: column;
		gap: 28px;
	}
	.lede {
		font-size: 23px;
		line-height: 1.45;
		color: var(--body);
	}
	.portrait {
		width: 300px;
		height: 375px;
		object-fit: cover;
		display: block;
		margin-top: 36px;
		border-radius: 2px;
	}
	.ways,
	.writing {
		display: flex;
		flex-direction: column;
		padding-bottom: 72px;
	}
	.ways-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 40px;
		padding-top: 28px;
	}
	.way {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.way h3 {
		font-size: 22px;
	}
	.way p {
		font-size: 17px;
		line-height: 1.5;
		color: var(--body-soft);
	}
	@media (max-width: 720px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 40px;
			padding-top: 48px;
			padding-bottom: 56px;
		}
		.hero-text {
			gap: 22px;
		}
		.lede {
			font-size: 20px;
		}
		.portrait {
			width: 200px;
			height: 250px;
			margin-top: 0;
		}
		.ways-grid {
			grid-template-columns: 1fr;
			gap: 28px;
		}
		.ways,
		.writing {
			padding-bottom: 56px;
		}
	}
</style>
