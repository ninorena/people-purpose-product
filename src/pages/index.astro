---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import MarketingLayout from '../layouts/MarketingLayout.astro';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<MarketingLayout
	title="People/Purpose/Product"
	description="We help you build products people actually use, and figure out where AI fits in your work."
>
	<!-- Hero -->
	<section class="hero">
		<h1>An experimentation practice<br />for mission-driven teams.</h1>
		<p class="tagline">
			We help you build products people actually use, and figure out where AI fits in your work.
		</p>
		<a href="/work-with-us" class="cta-button">Start a conversation →</a>
	</section>

	<!-- Audience -->
	<section class="section">
		<h2>Who this is for</h2>
		<p>
			You're a funded executive director, nonprofit program manager, government agency leader,
			or foundation program officer. You have a real problem and the budget to solve it.
			You want AI as leverage, not a replacement for the people and judgment that make your
			organization work.
		</p>
		<p>
			If you've been burned by vendors who built something and left, or consultants who
			delivered a deck and disappeared, this is a different kind of engagement.
		</p>
	</section>

	<!-- Services -->
	<section class="section">
		<h2>What we do</h2>
		<p>
			We design and build digital products with mission-driven organizations, and we teach
			you to use AI throughout the process. Not as a shortcut. As a capability your team
			keeps after we're gone.
		</p>
		<p>
			Every engagement ends with your team more capable than when it started. That's the point.
		</p>
		<a href="/ai" class="text-link">How we think about AI →</a>
	</section>

	<!-- Social Proof -->
	<section class="section">
		<h2>Organizations we've worked with</h2>
		<p class="proof-context">
			Before People/Purpose/Product, Nick spent years helping organizations like these
			use innovation tools and build new capabilities.
		</p>
		<ul class="client-list">
			<!-- TODO: replace text entries with logo once approved per client -->
			<li>Siemens</li>
			<li>Unilever</li>
			<li>General Mills</li>
			<li>Walmart Labs</li>
			<li>US Government</li>
			<li>United Way</li>
			<li>ChildFund International</li>
			<li>Asian Development Bank</li>
			<li>Cancer Research UK</li>
			<li>Davidson College</li>
			<li>European School of Management and Technology</li>
			<li>Nordic Innovation House</li>
		</ul>
		<p class="proof-footnote">And 20+ other organizations across corporate, nonprofit, government, and international development.</p>
	</section>

	<!-- Blog Preview -->
	<section class="section">
		<h2>From the blog</h2>
		<ul class="post-list">
			{recentPosts.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`}>
						<span class="post-title">{post.data.title}</span>
						<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
					</a>
				</li>
			))}
		</ul>
		<a href="/blog" class="text-link">Read all posts →</a>
	</section>

	<!-- Footer CTA -->
	<section class="section closing-cta">
		<p>Ready to talk about what you're building?</p>
		<a href="/work-with-us" class="cta-button">Work with us →</a>
	</section>
</MarketingLayout>

<style>
	/* Hero */
	.hero {
		padding: 4em 0 3em;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 3em;
	}
	.hero h1 {
		font-size: 3.5rem;
		line-height: 1.1;
		margin-bottom: 0.5em;
	}
	.tagline {
		font-size: 1.2rem;
		color: rgb(var(--gray-dark));
		max-width: 600px;
		margin-bottom: 1.5em;
	}

	/* CTA button */
	.cta-button {
		display: inline-block;
		background: var(--accent);
		color: white;
		padding: 0.75em 1.5em;
		border-radius: 4px;
		text-decoration: none;
		font-weight: 700;
		font-size: 1rem;
		transition: background 0.2s ease;
	}
	.cta-button:hover {
		background: var(--accent-dark);
		color: white;
	}

	/* Sections */
	.section {
		margin-bottom: 3.5em;
		padding-bottom: 3.5em;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.section:last-child {
		border-bottom: none;
	}
	.section h2 {
		font-size: 1.75rem;
		margin-bottom: 0.75em;
	}

	/* Text link */
	.text-link {
		font-weight: 700;
		color: var(--accent);
		text-decoration: none;
	}
	.text-link:hover {
		text-decoration: underline;
	}

	/* Client list */
	.proof-context {
		color: rgb(var(--gray));
		font-size: 0.95rem;
		margin-bottom: 1.25em;
	}
	.client-list {
		list-style: none;
		padding: 0;
		margin: 0 0 0.75em 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em 1.5em;
	}
	.client-list li {
		font-size: 1rem;
		color: rgb(var(--gray-dark));
	}
	.proof-footnote {
		font-size: 0.9rem;
		color: rgb(var(--gray));
		margin-top: 0.5em;
	}

	/* Blog post list */
	.post-list {
		list-style: none;
		padding: 0;
		margin: 0 0 1em 0;
	}
	.post-list li {
		margin-bottom: 0.75em;
	}
	.post-list a {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1em;
		text-decoration: none;
		color: rgb(var(--black));
		padding: 0.5em 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.post-list a:hover .post-title {
		color: var(--accent);
	}
	.post-title {
		font-weight: 700;
	}
	.post-date {
		font-size: 0.85rem;
		color: rgb(var(--gray));
		white-space: nowrap;
	}

	/* Closing CTA */
	.closing-cta {
		text-align: center;
		padding: 3em 0;
	}
	.closing-cta p {
		font-size: 1.3rem;
		margin-bottom: 1em;
		color: rgb(var(--gray-dark));
	}

	@media (max-width: 720px) {
		.hero h1 {
			font-size: 2.5rem;
		}
		.post-list a {
			flex-direction: column;
			gap: 0.25em;
		}
	}
</style>
