---
import { SITE_TITLE } from '../consts';

const links = [
	{ href: '/work', label: 'Work' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/about', label: 'About' },
];

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const section = '/' + (pathname.match(/[^\/]+/g)?.[0] || '');
---

<header>
	<nav class="wrap">
		<a class="name" href="/">{SITE_TITLE}</a>
		<div class="links">
			{links.map((l) => (
				<a href={l.href} class:list={{ active: l.href === section }} aria-current={l.href === section ? 'page' : undefined}>
					{l.label}
				</a>
			))}
		</div>
	</nav>
</header>
<style>
	header {
		border-bottom: 1px solid var(--rule);
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: 8px 32px;
		padding-top: 28px;
		padding-bottom: 24px;
	}
	.name {
		color: var(--text);
		font-size: 20px;
		font-weight: 500;
		letter-spacing: 0.01em;
		white-space: nowrap;
	}
	.links {
		display: flex;
		gap: 32px;
		font-size: 17px;
	}
	.links a {
		color: var(--text);
		border-bottom: 2px solid transparent;
		white-space: nowrap;
	}
	.links a.active {
		border-bottom-color: var(--link);
	}
	.name:hover,
	.links a:hover {
		color: var(--link-hover);
		text-decoration: none;
	}
	@media (max-width: 720px) {
		nav {
			padding-top: 20px;
			padding-bottom: 16px;
		}
		.links {
			gap: 24px;
			font-size: 16px;
		}
	}
</style>
