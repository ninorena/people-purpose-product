---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- TODO(nick): intro seeded from the pre-rebuild homepage — tune to taste -->
			<section class="intro">
				<h1>Hello, Reader!</h1>
				<p>
					Welcome to <b>People Purpose Product</b>, a blog about building products that
					actually serve people.
				</p>
				<p>
					<b>This blog is a translation layer.</b> I'm here to share what's working and
					what's not when it comes to building for impact, and to bridge the humanities
					and technology. If you can imagine a product that genuinely serves people,
					you're getting closer to being able to build it, and I want that to be a good
					thing.
				</p>
			</section>

			<section class="recent-posts">
				<h2>Recent posts</h2>
				<ul>
					{recentPosts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage && (
									<Image width={720} height={360} src={post.data.heroImage} alt="" />
								)}
								<h3 class="title">{post.data.title}</h3>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))}
				</ul>
				<p class="all-posts"><a href="/blog">All posts →</a></p>
			</section>

			<section class="work-note">
				<p>
					I also work with mission-driven teams on their products —
					<a href="/about#work-with-me">more here</a>.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		padding-bottom: 2em;
		margin-bottom: 2em;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.recent-posts h2 {
		font-size: 1.5rem;
		margin-bottom: 1em;
	}
	.recent-posts ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.recent-posts li {
		margin-bottom: 2.5em;
	}
	.recent-posts a {
		display: block;
		text-decoration: none;
	}
	.recent-posts img {
		width: 100%;
		height: auto;
		border-radius: 12px;
		margin-bottom: 0.5em;
	}
	.recent-posts a:hover img {
		box-shadow: var(--box-shadow);
	}
	.recent-posts .title {
		margin: 0;
		color: rgb(var(--black));
		font-size: 1.563em;
		line-height: 1.2;
	}
	.recent-posts a:hover .title,
	.recent-posts a:hover .date {
		color: var(--accent);
	}
	.recent-posts .date {
		margin: 0.25em 0 0;
		color: rgb(var(--gray));
		font-size: 0.95rem;
	}
	.all-posts a {
		font-weight: 700;
		color: var(--accent);
		text-decoration: none;
	}
	.all-posts a:hover {
		text-decoration: underline;
	}
	.work-note {
		margin-top: 3em;
		padding-top: 2em;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.work-note p {
		color: rgb(var(--gray));
		font-size: 0.95rem;
	}
	.work-note a {
		color: var(--accent);
	}
</style>
