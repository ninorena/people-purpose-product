---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout
	title="Case Studies — People/Purpose/Product"
	description="Real projects, real outcomes. Case studies published as engagements close."
>
	<section class="page-header">
		<h1>Case Studies</h1>
		<p class="subhead">
			Our first engagements are underway. Case studies will be published here as projects close.
		</p>
	</section>

	<section class="content-section">
		<!-- TODO: add case study entries here -->
		<p class="placeholder-note">
			Check back later — or <a href="/work-with-us">start a conversation</a> now.
		</p>
	</section>
</MarketingLayout>

<style>
	.page-header {
		padding: 3em 0 2.5em;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 3em;
	}
	.page-header h1 {
		font-size: 3rem;
		line-height: 1.1;
		margin-bottom: 0.4em;
	}
	.subhead {
		font-size: 1.15rem;
		color: rgb(var(--gray));
		max-width: 600px;
	}
	.content-section {
		max-width: 720px;
	}
	.placeholder-note {
		color: rgb(var(--gray));
	}
	.placeholder-note a {
		color: var(--accent);
		text-decoration: none;
	}
	.placeholder-note a:hover {
		text-decoration: underline;
	}
</style>
