---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<MarketingLayout title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<section class="wrap">
		<div class="measure page-header">
			<h1>Blog</h1>
			<p class="lede">
				The tools to build software are catching up to the people who know what's worth
				building. I write about what that makes possible, and what it asks of us.
			</p>
		</div>
	</section>

	<section class="wrap">
		<ul class="posts">
			{posts.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`}>
						{post.data.heroImage && (
							<Image class="thumb" src={post.data.heroImage} width={360} height={240} fit="cover" alt="" />
						)}
						<span class="text">
							<span class="head">
								<span class="title">{post.data.title}</span>
								<span class="date"><FormattedDate date={post.data.pubDate} /></span>
							</span>
							<span class="description">{post.data.description}</span>
						</span>
					</a>
				</li>
			))}
		</ul>
	</section>
</MarketingLayout>

<style>
	.page-header {
		display: flex;
		flex-direction: column;
		gap: 24px;
		padding: 96px 0 48px;
	}
	.lede {
		font-size: 22px;
		line-height: 1.45;
		color: var(--body);
	}
	.posts {
		list-style: none;
		margin: 0;
		padding: 0 0 72px;
		max-width: 860px;
	}
	.posts li {
		border-top: 1px solid var(--rule);
	}
	.posts li:last-child {
		border-bottom: 1px solid var(--rule);
	}
	.posts a {
		display: grid;
		grid-template-columns: 180px minmax(0, 1fr);
		gap: 28px;
		align-items: start;
		padding: 28px 0;
		color: var(--text);
	}
	.posts a:hover {
		text-decoration: none;
	}
	.posts a:hover .title {
		color: var(--link-hover);
		text-decoration: underline;
	}
	.thumb {
		width: 180px;
		height: 120px;
		object-fit: cover;
		display: block;
		border-radius: 2px;
	}
	.text {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: 4px 24px;
	}
	.title {
		font-size: 28px;
		font-weight: 500;
		line-height: 1.2;
	}
	.date {
		font-size: 15px;
		color: var(--muted);
		white-space: nowrap;
	}
	.description {
		font-size: 18px;
		line-height: 1.5;
		color: var(--body-soft);
		text-wrap: pretty;
	}
	@media (max-width: 720px) {
		.page-header {
			padding: 48px 0 32px;
			gap: 18px;
		}
		.lede {
			font-size: 20px;
		}
		.posts {
			padding-bottom: 56px;
		}
		.posts a {
			grid-template-columns: 120px minmax(0, 1fr);
			gap: 16px;
			padding: 20px 0;
		}
		.thumb {
			width: 120px;
			height: 80px;
		}
		.title {
			font-size: 22px;
		}
		.description {
			font-size: 16px;
		}
	}
</style>
