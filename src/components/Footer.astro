---
import { LINKEDIN_URL, SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<div class="wrap inner">
		<div>&copy; {year} {SITE_TITLE}</div>
		<a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">LinkedIn</a>
	</div>
</footer>
<style>
	footer {
		margin-top: auto;
		border-top: 1px solid var(--rule);
		font-size: 15px;
		color: var(--muted);
	}
	.inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 8px 24px;
		padding-top: 28px;
		padding-bottom: 36px;
	}
	a {
		color: var(--muted);
	}
	a:hover {
		color: var(--link-hover);
	}
</style>
