---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PostRows from '../components/PostRows.astro';
import portrait from '../assets/nick-portrait.jpg';
import { SCHEDULING_LINK, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<MarketingLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="wrap hero">
		<div class="hero-text">
			<p class="label">Fractional product lead for nonprofits and impact-focused organizations</p>
			<h1>You know what your community needs. I help you find out which ideas work, fast, and walk back the ones that don't.</h1>
			<p class="lede">
				Building software is getting cheaper. That moves the hard part to choosing what's
				worth building, and you're closer to that call than anyone. As your product lead, I
				turn your ideas into small tests, read what comes back, and help someone on your team
				keep it going after I'm gone.
			</p>
			<div class="cta-block">
				<a class="primary" href={SCHEDULING_LINK} target="_blank" rel="noopener noreferrer">Book 30 minutes &rarr;</a>
				<p class="cta-note">
					Bring the decision you're stuck on. You'll leave with my read on what to build
					first, and one experiment you could run this month.
				</p>
			</div>
		</div>
		<Image class="portrait" src={portrait} width={600} height={750} alt="Nick Noreña" loading="eager" />
	</section>

	<section class="wrap ways">
		<div class="label ruled">How we work together</div>
		<p class="ways-intro">
			Someone on your team is the product owner today, with or without the title. They know
			the community and make the final call. A product lead brings their ideas to life and
			tests them quickly, so you know what's worth scaling for your users. I can do that job
			with you, teach it, or both. Which one depends on where you are, and it can change
			partway through.
		</p>
		<div class="ways-grid">
			<div class="way">
				<h3><a href="/work">Fractional product lead</a></h3>
				<p>The roadmap and the final call stay yours. I draft the requirements, design the experiments, and read what comes back. Fits when your team has ideas and engineers, and nobody with the time to turn ideas into tests.</p>
			</div>
			<div class="way">
				<h3><a href="/work">Product owner coaching</a></h3>
				<p>For the person already doing this job without the title. Fits when someone on your team has the instincts and has never had anyone to learn the craft from.</p>
			</div>
		</div>
	</section>

	<section class="wrap writing">
		<PostRows label="Writing" posts={recentPosts} />
	</section>
</MarketingLayout>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 300px;
		gap: 64px;
		align-items: start;
		padding-top: 88px;
		padding-bottom: 88px;
	}
	.hero-text {
		display: flex;
		flex-direction: column;
		gap: 28px;
	}
	.lede {
		font-size: 23px;
		line-height: 1.45;
		color: var(--body);
	}
	.cta-block {
		display: flex;
		flex-direction: column;
		gap: 14px;
		align-items: flex-start;
	}
	.cta-note {
		font-size: 17px;
		line-height: 1.5;
		color: var(--muted);
		max-width: 520px;
	}
	.portrait {
		width: 300px;
		height: 375px;
		object-fit: cover;
		display: block;
		margin-top: 36px;
		border-radius: 2px;
	}
	.ways,
	.writing {
		display: flex;
		flex-direction: column;
		padding-bottom: 72px;
	}
	.ways-intro {
		font-size: 19px;
		line-height: 1.55;
		color: var(--body);
		max-width: 760px;
		padding-top: 28px;
	}
	.ways-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 40px;
		padding-top: 32px;
	}
	.way {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.way h3 {
		font-size: 22px;
	}
	.way h3 a {
		color: var(--text);
	}
	.way h3 a:hover {
		color: var(--link);
	}
	.way p {
		font-size: 17px;
		line-height: 1.5;
		color: var(--body-soft);
	}
	@media (max-width: 720px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 40px;
			padding-top: 48px;
			padding-bottom: 56px;
		}
		.hero-text {
			gap: 22px;
		}
		.lede {
			font-size: 20px;
		}
		.portrait {
			width: 200px;
			height: 250px;
			margin-top: 0;
		}
		.ways-grid {
			grid-template-columns: 1fr;
			gap: 28px;
		}
		.ways,
		.writing {
			padding-bottom: 56px;
		}
	}
</style>
