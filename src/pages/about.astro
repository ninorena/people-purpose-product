---
import { Image } from 'astro:assets';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import portrait from '../assets/nick-portrait.jpg';
import { LINKEDIN_URL, SCHEDULING_LINK } from '../consts';

// TODO(Nick): replace from the LinkedIn Experience section.
const workedAt = ['Kromatic', 'Exygy', 'Crow Flies'];

const workedWith = [
	'City of Detroit',
	'Bay Area Housing Finance Authority',
	'San Francisco DCYF',
	"Driver's Seat Cooperative",
	'The Nature Conservancy',
	'Nordic Innovation House',
	'United Way',
	'ChildFund International',
	'Cancer Research UK',
	'US Government',
	'Siemens',
	'Unilever',
	'General Mills',
	'Walmart Labs',
];
---

<MarketingLayout
	title="About | People Purpose Product"
	description="Nick Noreña works as the product owner for mission-driven teams that have funding and no software DNA."
>
	<section class="wrap">
		<div class="measure page-header">
			<h1>About</h1>
			<p class="lede">
				People Purpose Product is my practice. I work as the product owner for
				mission-driven teams that have funding and no software DNA, and this blog is where
				I think out loud about that work. The purpose is simple: help the helpers of the
				world have a bigger impact through software.
			</p>
		</div>
	</section>

	<section class="wrap person">
		<div class="photo-col">
			<Image class="photo" src={portrait} width={560} height={700} alt="Nick Noreña" loading="eager" />
			<div class="name">Nick Noreña</div>
			<div class="role">Founder</div>
		</div>
		<div class="bio">
			<p>
				I've spent my career moving between coaching and product management, always close to the people
				a product serves. I was a founding team member and Head of Coaching at Kromatic, where
				I worked with more than 30 organizations, including Siemens, Unilever, General Mills,
				the US Government, and United Way, teaching innovation tools and coaching teams through
				discovery and validation.
			</p>
			<p>
				As a product manager, I've shipped products that serve people: affordable
				housing platforms for the City of Detroit and the Bay Area, a resource directory
				connecting San Francisco families to critical services, and a worker-owned platform
				advancing economic justice for gig workers with Driver's Seat Cooperative. Most
				recently, I've been leading product on AI tools that help parents navigate government
				benefits programs.
			</p>
			<p>
				Now I'm focused on a narrow question: what happens when mission-driven organizations
				get access to the same tools enterprises have, and use them without losing what makes
				them different?
			</p>
		</div>
	</section>

	<section class="wrap">
		<div class="names">
			<div class="names-row">
				<div class="label">Worked at</div>
				<div class="companies">
					{workedAt.map((name) => <span>{name}</span>)}
				</div>
			</div>
			<div class="names-row">
				<div class="label">Worked with</div>
				<div class="companies">
					{workedWith.map((name) => <span>{name}</span>)}
				</div>
			</div>
		</div>
	</section>

	<section class="wrap">
		<div class="measure closing">
			<p>
				If any of this resonates, I'd love to talk. Book a 30 minute call to go over what
				you are working on and how I can help.
			</p>
			<div class="cta-row">
				<a class="primary" href={SCHEDULING_LINK} target="_blank" rel="noopener noreferrer">Find a time &rarr;</a>
				<span class="aside">Prefer email? Write me at <a class="email-link" href={LINKEDIN_URL}>hello at this domain</a>.</span>
			</div>
		</div>
	</section>
</MarketingLayout>

<script>
	// Assemble the address in the browser so scrapers reading the raw HTML
	// never see a complete email. The href above is a fallback (LinkedIn)
	// for the rare no-JS visitor.
	const user = 'hello';
	const domain = 'peoplepurposeproduct.com';
	const address = `${user}@${domain}`;
	document.querySelectorAll('.email-link').forEach((el) => {
		el.setAttribute('href', `mailto:${address}`);
		el.textContent = address;
	});
</script>

<style>
	.page-header {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 24px;
		padding: 96px 0 56px;
	}
	.lede {
		font-size: 22px;
		line-height: 1.45;
		color: var(--body);
	}

	.person {
		display: grid;
		grid-template-columns: 280px minmax(0, 1fr);
		gap: 48px;
		align-items: start;
		padding-bottom: 48px;
	}
	.photo-col {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.photo {
		width: 280px;
		height: 350px;
		object-fit: cover;
		display: block;
		border-radius: 2px;
	}
	.name {
		font-size: 22px;
		font-weight: 500;
		color: var(--text);
	}
	.role {
		font-size: 15px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.bio {
		display: flex;
		flex-direction: column;
		gap: 18px;
		max-width: 620px;
	}
	.bio p,
	.closing p {
		font-size: 19px;
		line-height: 1.55;
		color: var(--body);
	}

	.names {
		display: flex;
		flex-direction: column;
		gap: 36px;
		padding: 40px 0 48px;
		border-top: 1px solid var(--rule);
	}
	.names-row {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.companies {
		display: flex;
		flex-wrap: wrap;
		gap: 14px 40px;
		align-items: baseline;
	}
	.companies span {
		font-size: 22px;
		font-weight: 500;
		color: var(--company);
		letter-spacing: 0.01em;
		white-space: nowrap;
	}

	.closing {
		display: flex;
		flex-direction: column;
		gap: 18px;
		padding: 48px 0 72px;
		border-top: 1px solid var(--rule);
	}

	@media (max-width: 720px) {
		.page-header {
			padding: 48px 0 40px;
			gap: 18px;
		}
		.lede {
			font-size: 20px;
		}
		.person {
			grid-template-columns: 1fr;
			gap: 28px;
			padding-bottom: 40px;
		}
		.photo {
			width: 200px;
			height: 250px;
		}
		.companies {
			gap: 10px 20px;
		}
		.companies span {
			font-size: 19px;
			white-space: normal;
		}
		.names {
			padding: 32px 0 40px;
		}
		.closing {
			padding: 40px 0 56px;
		}
	}
</style>
