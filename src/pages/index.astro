---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>Welcome, Reader</h1>
				<p>
					<b>People Purpose Product</b> is a blog exploring the intersection of people, their purpose, and the products
					they build and use.
				</p>
				<p>
					The tools to build software are catching up to the people who know what's worth building. 
					Teachers, caseworkers, organizers, founders: people who have spent years close to real problems 
					can now turn what they know into working products. I write about what that makes possible, 
					and what it asks of us.
				</p>
				<p>
					Every post here starts with some version of the same question: <b>now that anyone can build, what should we?</b>
				</p>
			</section>

			<section class="recent-posts">
				<h2>Recent posts</h2>
				<ul>
					{recentPosts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage && (
									<Image width={360} height={240} src={post.data.heroImage} alt="" class="thumb" />
								)}
								<div class="post-text">
									<h3 class="title">{post.data.title}</h3>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</div>
							</a>
						</li>
					))}
				</ul>
				<p class="all-posts"><a href="/blog">All posts →</a></p>
			</section>

			<section class="work-note">
				<p>
					I also work with mission-driven teams on their products —
					<a href="/about#work-with-me">more here</a>.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		padding-bottom: 2em;
		margin-bottom: 2em;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.recent-posts h2 {
		font-size: 1.5rem;
		margin-bottom: 1em;
	}
	.recent-posts ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.recent-posts li {
		margin-bottom: 1.5em;
	}
	.recent-posts a {
		display: flex;
		align-items: center;
		gap: 1.25em;
		text-decoration: none;
	}
	.recent-posts .thumb {
		width: 180px;
		height: 120px;
		min-width: 180px;
		object-fit: cover;
		border-radius: 8px;
	}
	.recent-posts a:hover .thumb {
		box-shadow: var(--box-shadow);
	}
	.recent-posts .title {
		margin: 0;
		color: rgb(var(--black));
		font-size: 1.25em;
		line-height: 1.3;
	}
	.recent-posts a:hover .title,
	.recent-posts a:hover .date {
		color: var(--accent);
	}
	.recent-posts .date {
		margin: 0.25em 0 0;
		color: rgb(var(--gray));
		font-size: 0.95rem;
	}
	.all-posts a {
		font-weight: 700;
		color: var(--accent);
		text-decoration: none;
	}
	.all-posts a:hover {
		text-decoration: underline;
	}
	.work-note {
		margin-top: 3em;
		padding-top: 2em;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.work-note p {
		color: rgb(var(--gray));
		font-size: 0.95rem;
	}
	.work-note a {
		color: var(--accent);
	}
	@media (max-width: 720px) {
		.recent-posts .thumb {
			width: 120px;
			height: 80px;
			min-width: 120px;
		}
	}
</style>
